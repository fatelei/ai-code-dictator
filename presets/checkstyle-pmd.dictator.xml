<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!-- presets/checkstyle-pmd.dictator.xml: Zero-tolerance Checkstyle rules for AI-assisted Java -->
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="FileLength">
    <property name="max" value="350"/>
  </module>

  <module name="TreeWalker">
    <!-- Anti-bloat ceilings -->
    <module name="MethodLength">
      <property name="max" value="50"/>
      <property name="countEmpty" value="false"/>
    </module>
    <module name="CyclomaticComplexity">
      <property name="max" value="10"/>
    </module>
    <module name="NestedIfDepth">
      <property name="max" value="3"/>
    </module>
    <module name="ParameterNumber">
      <property name="max" value="5"/>
    </module>

    <!-- Zero silent failures & debug slop -->
    <module name="EmptyCatchBlock">
      <property name="exceptionVariableName" value="expected|ignore"/>
    </module>
    <module name="IllegalCatch">
      <property name="illegalClassNames" value="java.lang.Exception, java.lang.Throwable, java.lang.RuntimeException"/>
    </module>
    <module name="RegexpSinglelineJava">
      <property name="format" value="\.printStackTrace\("/>
      <property name="message" value="[Code Dictator] printStackTrace() is banned. Use structured SLF4J logging."/>
      <property name="ignoreComments" value="true"/>
    </module>
    <module name="RegexpSinglelineJava">
      <property name="format" value="System\.(out|err)\.print"/>
      <property name="message" value="[Code Dictator] System.out/err is banned. Use structured SLF4J logging."/>
      <property name="ignoreComments" value="true"/>
    </module>

    <!-- Clean imports & types -->
    <module name="UnusedImports"/>
    <module name="AvoidStarImport"/>
    <module name="MagicNumber">
      <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
      <property name="ignoreAnnotation" value="true"/>
    </module>
  </module>
</module>
